generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  dueDate   DateTime
  dueTime   String?  // HH:MM in local time, e.g. "20:00"
  subject   String?
  status    String   @default("pending") // pending | in_progress | done | overdue
  priority  String   @default("medium")  // low | medium | high — auto-overridden by UI
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  estimatedHours Float?  // null = no estimate given
  hoursSpent     Float   @default(0) // hours logged so far
}

model RunLog {
  id               Int      @id @default(autoincrement())
  date             DateTime
  distance         Float    // km
  duration         Int      // seconds
  notes            String?
  stravaId         String?  // Strava activity ID — null for manually logged runs
  // Snapshot of the planned distance for this date, copied from the matching
  // RunPlan before it was deleted. Lets weekPlannedKm survive after runs
  // happen so the "vs plan" bar keeps its target through the current week.
  plannedDistance  Float?
  // Strava per-activity best_efforts as JSON: [{ name: "5k", movingSec: 1234 }, …].
  // Populated on Strava sync (or via /api/strava/sync-efforts for backfill).
  // Null for manual runs or Strava runs older than the best-efforts sync.
  bestEffortsJson  String?
  // Historic weather at the run's start, from open-meteo's archive endpoint.
  // Shape: { tempC, feelsLikeC, windMs, rainMm, weatherCode, source: "archive"|"manual" }.
  // Populated on Strava sync (uses activity's start_latlng) or via
  // /api/strava/sync-weather for backfill; manual runs use Aarhus coords.
  weatherJson      String?
  // Strava HR zone breakdown as JSON: { z1..z5: seconds, maxHrEstimate, sampleCount }.
  // Populated on Strava sync + via /api/strava/sync-hr-zones. Null when a run
  // has no HR stream (no watch) or is manually logged.
  hrZonesJson      String?
  // Which shoe was used. Optional — a run can exist without a shoe assigned,
  // e.g. legacy runs before shoes were introduced.
  shoeId           Int?
  createdAt        DateTime @default(now())
}

// Running shoe — used to warn when a pair is due for rotation. Km per shoe is
// derived from `RunLog.shoeId` on read (no denormalised total).
model Shoe {
  id           Int      @id @default(autoincrement())
  name         String
  purchaseDate DateTime?
  retired      Boolean  @default(false)
  sortOrder    Int      @default(0)
  notes        String   @default("")
  createdAt    DateTime @default(now())
}

model RunPlan {
  id        Int      @id @default(autoincrement())
  date      DateTime
  distance  Float?   // planned km (null = rest day)
  type      String   // easy | tempo | long | rest
  notes     String?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model WowCharacter {
  id        Int      @id @default(autoincrement())
  name      String
  realm     String
  region    String   @default("eu")
  sortOrder Int      @default(0)
  notes     String   @default("")
  createdAt DateTime @default(now())

  @@unique([name, realm, region])
}

model WowChecklist {
  id          Int      @id @default(autoincrement())
  characterId Int
  weekStart   DateTime // Wednesday reset week start
  task        String
  done        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([characterId, weekStart, task])
}

model WowChecklistTemplate {
  id        Int     @id @default(autoincrement())
  task      String  @unique
  isDefault Boolean @default(false)
}

model WowGearWishlist {
  id          Int     @id @default(autoincrement())
  characterId Int
  slot        String
  itemName    String  @default("")
  obtained    Boolean @default(false)

  @@unique([characterId, slot])
}

// League of Legends account tracked in the GameHub. Riot IDs are the modern
// identifier: `gameName#tagLine` (e.g. "Rasmus#EUW"). Puuid is the immutable
// Riot player id, populated on first successful lookup via the Riot API.
model LolAccount {
  id        Int      @id @default(autoincrement())
  gameName  String
  tagLine   String
  region    String   @default("euw1")  // platform routing value (euw1, na1, kr, …)
  puuid     String?                    // filled in once Riot API returns it
  sortOrder Int      @default(0)
  notes     String   @default("")
  createdAt DateTime @default(now())

  @@unique([gameName, tagLine, region])
}

// Danish TV show tracked in the MediaHub. Manual entry only — no scrape.
// `airDays` is a comma-separated list of JS day numbers (0=Sun … 6=Sat) so
// SQLite doesn't need a JSON column. `airTime` is a local HH:MM string.
model MediaShow {
  id          Int      @id @default(autoincrement())
  title       String
  channel     String   @default("")   // e.g. DR1 / TV2 / Netflix / Kanal 5
  airDays     String   @default("")   // "0,3,5" — empty = no scheduled days
  airTime     String   @default("")   // "20:00" — empty when air time varies
  active      Boolean  @default(true) // false = on hiatus, hidden from grid
  episodesSeen Int     @default(0)    // ticks up in the hub for progress
  maxEpisodes Int?                     // optional total episode count; once
                                       // episodesSeen >= maxEpisodes the show
                                       // auto-drops from Tonight / Next up
  notes       String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

// Snapshot of a LoL account's ranked standing, written at most once per
// (account, queue, day) so the sparkline in the LoL Hub can show LP-trend.
// Populated as a side effect of the /api/lol/summary fetch — no cron job.
model LolRankSnapshot {
  id            Int      @id @default(autoincrement())
  accountId     Int
  capturedAt    DateTime @default(now())
  queueType     String   // RANKED_SOLO_5x5 | RANKED_FLEX_SR
  tier          String   // IRON..CHALLENGER
  division      String   // I..IV (empty for master/gm/chall)
  leaguePoints  Int
  wins          Int
  losses        Int

  @@index([accountId, queueType, capturedAt])
}
